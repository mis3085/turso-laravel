{
    "name": "mis3085/turso-laravel",
    "description": "A Turso/LibSQL database driver for Laravel",
    "type": "library",
    "keywords": [
        "turso",
        "libsql",
        "laravel",
        "turso-laravel"
    ],
    "homepage": "https://github.com/mis3085/turso-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "mis3085",
            "role": "Maintainer"
        },
        {
            "name": "Richan Fongdasen",
            "email": "richan.fongdasen@gmail.com",
            "role": "Original developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/bus": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/queue": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1|^9.0",
        "orchestra/testbench": "^9.0.0|^10.0|^11.0",
        "pestphp/pest": "^3.5|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mis3085\\Turso\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mis3085\\Turso\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-turso-laravel --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve --host=0.0.0.0"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest --stop-on-failure --stop-on-error",
        "test-coverage": "vendor/bin/pest --coverage --stop-on-failure --stop-on-error",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mis3085\\Turso\\TursoLaravelServiceProvider"
            ],
            "aliases": {
                "Turso": "Mis3085\\Turso\\Facades\\Turso"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
